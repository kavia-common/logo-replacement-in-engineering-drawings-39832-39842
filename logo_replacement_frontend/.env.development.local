# Development-only overrides for CRA dev server to allow remote preview host access.
# Binding to all interfaces ensures the preview URL can reach the dev server.
HOST=0.0.0.0

# Disable strict host checking so the dev server accepts the preview-provided host header.
# Note: This is for development preview environments only, never commit similar settings for production.
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Ensure the Webpack Dev Server client uses the expected socket port in preview environments.
WDS_SOCKET_PORT=3000
